---
import { Image } from 'astro:assets';

import Logo from '../assets/logo.png';
---

<footer class="footer">
  <div class="footer-inner anim-target">
    <Image class="footer-logo media-img" src={Logo} alt="柔整おがわ屋" />
  </div>
  <small class="footer-copyright anim-target anim-target--delay-1">&copy; 2026 柔整おがわ屋</small>
</footer>

<style lang="scss">
  @use '../styles/variables' as *;

  .footer {
    padding: 40px $section-padding-x;
    background-color: $color-bg-dark;
    color: $color-text-inverse;
  }

  .footer-inner {
    max-width: $inner-max-width;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .footer-logo {
    width: 100px;
    margin-left: auto;
    margin-right: auto;
  }

  .footer-copyright {
    display: flex;
    justify-content: center;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: $font-size-xs;
    color: rgba(255, 255, 255, 0.6);
  }
</style>
