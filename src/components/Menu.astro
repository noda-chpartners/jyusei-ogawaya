---
import { Image } from 'astro:assets';

import item01 from '../assets/item09.png';
import item02 from '../assets/item07.png';
import item03 from '../assets/item08.png';
import item04 from '../assets/item05.png';
import item05 from '../assets/item06.png';

const menuItems = [
  { id: 1, name: 'お任せ整体70分', price: '5500円', image: item01 },
  { id: 2, name: 'お任せ整体125分', price: '9900円', image: item02 },
  { id: 3, name: 'お任せ整体85分', price: '6600円', image: item03 },
  { id: 4, name: 'お任せ整体55分', price: '4400円', image: item04 },
  { id: 5, name: 'お任せ整体110分', price: '8800円', image: item05 },
];
---

<section class="section" id="menu">
  <div class="section-inner">
    <header class="section-header anim-target">
      <h2 class="section-heading">メニュー</h2>
      <span class="section-heading-sub">Menu</span>
      <span class="anim-heading-line"></span>
    </header>
    <div class="section-body">
      <ul class="menu-list anim-stagger-group anim-target">
        {menuItems.map((item) => (
          <li class="menu-item anim-stagger-item">
            <div class="menu-item-img-wrap">
              <Image class="menu-item-img anim-menu-img media-img" src={item.image} alt="" />
            </div>
            <div class="menu-item-body">
              <p class="menu-item-name">{item.name}</p>
              <p class="menu-item-price">{item.price}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="text-note menu-note anim-target anim-target--delay-1">
        ※税込み<br />
        ※初回500円引き
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .menu-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .menu-item {
    display: flex;
    align-items: stretch;
    padding: 24px;
    background-color: $color-bg-warm;
  }

  .menu-item-img-wrap {
    flex-shrink: 0;
    width: 280px;
    height: 210px;
    overflow: hidden;
  }

  .menu-item-img {
    width: 100%;
    height: 100%;
  }

  .menu-item-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex: 1;
    text-align: center;
  }

  .menu-item-name {
    font-size: $font-size-lg;
    letter-spacing: 0.1em;
  }

  .menu-item-price {
    font-size: $font-size-md;
    color: $color-accent;
  }

  .menu-note {
    text-align: center;
  }

  @for $i from 1 through 5 {
    .menu-item:nth-child(#{$i}) {
      --anim-index: #{$i - 1};
    }
  }

  @include tablet-down {
    .menu-item-img-wrap {
      width: 220px;
      height: 165px;
    }
  }

  @include mobile-down {
    .menu-list {
      gap: 24px;
    }

    .menu-item {
      flex-direction: column;
      padding: 20px;
    }

    .menu-item-img-wrap {
      width: 100%;
      height: 200px;
    }

    .menu-item-name {
      font-size: $font-size-md;
    }
  }
</style>
