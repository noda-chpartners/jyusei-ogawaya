---
import { Image } from 'astro:assets';

import Logo from'../assets/logo.png';
---

<header class="header">
  <div class="header-inner">
    <h1 class="header-logo">
      <a href="/" class="header-logo-link">
        <Image src={ Logo } alt="柔整おがわ屋" />
      </a>
    </h1>
    <nav class="header-nav">
      <ul class="header-nav-list">
        <li class="header-nav-item"><a href="" class="header-nav-link">挨拶</a></li>
        <li class="header-nav-item"><a href="" class="header-nav-link">メニュー</a></li>
        <li class="header-nav-item"><a href="" class="header-nav-link">基本情報</a></li>
        <li class="header-nav-item"><a href="" class="header-nav-link">アクセス</a></li>
        <li class="header-nav-item"><a href="" class="header-nav-link">お問い合わせ</a></li>
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  @use '../styles//variables' as *;
  @use '../styles/mixins' as *;

  .header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    color: #ffffff;
  }
</style>